@model IEnumerable<MyRACIT.Models.Entities.User>

@{
    ViewData["Title"] = "Користувачі";
}

<h1>📋 Список користувачів</h1>
<p>Всього користувачів: <strong>@Model.Count()</strong></p>

<p>
    <a asp-action="CreateStudent" class="btn btn-success">➕ Додати студента</a>
    <a asp-action="CreateTeacher" class="btn btn-info">➕ Додати викладача</a>
    <a asp-action="CreateAdmin" class="btn btn-danger">➕ Додати адміністратора</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>ПІБ</th>
            <th>Email</th>
            <th>Роль</th>
            <th>Дії</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Id</td>
                <td>@user.Name</td>
                <td>@user.Email</td>
                <td>
                    @if (user.Role == MyRACIT.Models.Entities.UserRole.Student)
                    {
                        <span class="badge bg-success">🎓 Студент</span>
                    }
                    else if (user.Role == MyRACIT.Models.Entities.UserRole.Teacher)
                    {
                        <span class="badge bg-info">📚 Викладач</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">👑 Адмін</span>
                    }
                </td>
                <td>
                    <a asp-action="DeleteUser" asp-route-id="@user.Id" class="btn btn-sm btn-danger">🗑️ Видалити</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-warning">
        <strong>⚠️ Увага!</strong> Користувачів не знайдено. Додайте першого користувача.
    </div>
}
