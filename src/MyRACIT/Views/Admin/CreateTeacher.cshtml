@{
    ViewData["Title"] = "Створити викладача";
}

<h1>➕ Створити викладача</h1>
<p class="text-muted">Використовується <strong>Factory Method Pattern</strong> для створення користувача</p>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="CreateTeacher" method="post">
            <div class="mb-3">
                <label for="name" class="form-label">ПІБ викладача</label>
                <input type="text" class="form-control" id="name" name="name" required 
                       placeholder="Сидоренко Олена Миколаївна" />
            </div>
            
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" name="email" required 
                       placeholder="sidorenko@teacher.rfkit.edu.ua" />
                <div class="form-text">Пароль буде автоматично згенеровано та відправлено на email</div>
            </div>
            
            <div class="mb-3">
                <label for="departmentId" class="form-label">Кафедра</label>
                <select class="form-select" id="departmentId" name="departmentId" required>
                    <option value="">-- Оберіть кафедру --</option>
                    @foreach (var dept in ViewBag.Departments as List<MyRACIT.Models.Entities.Department>)
                    {
                        <option value="@dept.Id">@dept.Name</option>
                    }
                </select>
            </div>
            
            <div class="mb-3">
                <button type="submit" class="btn btn-info">✅ Створити викладача</button>
                <a asp-action="Users" class="btn btn-secondary">↩️ Назад</a>
            </div>
        </form>
    </div>
    
    <div class="col-md-6">
        <div class="alert alert-info">
            <h5>🏭 Factory Method Pattern</h5>
            <p>Фабрика <code>UserFactory.CreateTeacher()</code> автоматично:</p>
            <ul>
                <li>Генерує безпечний випадковий пароль (12 символів)</li>
                <li>Хешує пароль за допомогою SHA256</li>
                <li>Призначає роль <code>UserRole.Teacher</code></li>
                <li>Логує створення користувача</li>
            </ul>
            <p class="mb-0">
                <strong>Переваги:</strong> Єдина точка створення всіх типів користувачів з різною логікою для кожної ролі.
            </p>
        </div>
        
        <div class="alert alert-warning">
            <h5>⚠️ TODO</h5>
            <p class="mb-0">Додати відправку email з паролем викладачу.</p>
        </div>
    </div>
</div>
