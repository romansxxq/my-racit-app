@model IEnumerable<MyRACIT.Models.Entities.TeacherProfile>

@{
    ViewData["Title"] = "Управління викладачами";
}

<div class="row mb-3">
    <div class="col">
        <h2>‍ Управління викладачами</h2>
    </div>
    <div class="col text-end">
        <a asp-action="CreateTeacher" class="btn btn-success">
             Додати викладача
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <strong> Інформація:</strong> Викладачі відсутні. Додайте першого викладача.
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th></th>
                        <th>ПІБ</th>
                        <th>Email</th>
                        <th>Кафедра</th>
                        <th style="width: 150px;">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var index = 1;
                    }
                    @foreach (var teacher in Model)
                    {
                        <tr>
                            <td>@index</td>
                            <td><strong>@teacher.User?.Name</strong></td>
                            <td>@teacher.User?.Email</td>
                            <td><span class="badge bg-warning text-dark">@teacher.Department?.Name</span></td>
                            <td>
                                <a asp-action="TeacherDetails" asp-route-id="@teacher.Id" 
                                   class="btn btn-sm btn-info" title="Деталі">
                                    Деталі
                                </a>
                                <button type="button" class="btn btn-sm btn-danger" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#deleteModal@(teacher.Id)"
                                        title="Видалити">
                                    Видалити
                                </button>
                            </td>
                        </tr>
                        
                        <div class="modal fade" id="deleteModal@(teacher.Id)" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header bg-danger text-white">
                                        <h5 class="modal-title">Підтвердження видалення</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>Ви впевнені, що хочете видалити викладача <strong>"@teacher.User?.Name"</strong>?</p>
                                        <p class="text-danger"><small> Увага: Ця дія незворотня!</small></p>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                                        <form asp-action="DeleteTeacher" asp-route-id="@teacher.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-danger">Так, видалити</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        index++;
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="mt-3">
        <p class="text-muted">
            <small>Всього викладачів: <strong>@Model.Count()</strong></small>
        </p>
    </div>
}
