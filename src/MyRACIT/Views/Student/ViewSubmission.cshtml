@model MyRACIT.Models.Entities.Submission

@{
    ViewData["Title"] = "Перегляд здачі";
}

<div class="row">
    <div class="col-md-10 offset-md-1">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Мої курси</a></li>
                <li class="breadcrumb-item"><a asp-action="MySubmissions">Мої здачі</a></li>
                <li class="breadcrumb-item active">Деталі</li>
            </ol>
        </nav>
        
        <div class="card">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">📄 Моя здана робота</h4>
                <a asp-action="MySubmissions" class="btn btn-light btn-sm">⬅️ Назад</a>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h5>Завдання</h5>
                        <table class="table table-borderless">
                            <tr>
                                <th>Назва:</th>
                                <td><strong>@Model.Assignment?.Title</strong></td>
                            </tr>
                            <tr>
                                <th>Опис:</th>
                                <td>@Model.Assignment?.Description</td>
                            </tr>
                            <tr>
                                <th>Курс:</th>
                                <td>@Model.Assignment?.Course?.Subject?.Title</td>
                            </tr>
                            <tr>
                                <th>Викладач:</th>
                                <td>@Model.Assignment?.Course?.Teacher?.User?.Name</td>
                            </tr>
                            <tr>
                                <th>Макс. балів:</th>
                                <td><strong>@Model.Assignment?.MaxGrade</strong></td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h5>Моя здача</h5>
                        <table class="table table-borderless">
                            <tr>
                                <th>Дедлайн:</th>
                                <td>@Model.Assignment?.Deadline.ToString("dd.MM.yyyy HH:mm")</td>
                            </tr>
                            <tr>
                                <th>Здано:</th>
                                <td>
                                    @Model.SubmittedAt.ToString("dd.MM.yyyy HH:mm")
                                    @if (Model.SubmittedAt > Model.Assignment?.Deadline)
                                    {
                                        <span class="badge bg-danger ms-1">Прострочено</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success ms-1">Вчасно</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>Статус:</th>
                                <td>
                                    @if (Model.Grade != null)
                                    {
                                        <span class="badge bg-success">Оцінено</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Очікує оцінки</span>
                                    }
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                
                <hr />
                
                <div class="mb-4">
                    <h5>Мій текст роботи</h5>
                    <div class="border rounded p-3 bg-light" style="white-space: pre-wrap;">@Model.Content</div>
                </div>
                
                @if (!string.IsNullOrEmpty(Model.FilePath))
                {
                    <div class="mb-4">
                        <h5>Прикріплений файл</h5>
                        <a href="@Model.FilePath" class="btn btn-primary" download>
                            📎 Завантажити файл
                        </a>
                    </div>
                }
                
                <hr />
                
                @if (Model.Grade != null)
                {
                    var percentage = (double)Model.Grade.Value / Model.Assignment?.MaxGrade * 100;
                    var alertClass = percentage >= 75 ? "alert-success" : percentage >= 50 ? "alert-warning" : "alert-danger";
                    var badgeClass = percentage >= 75 ? "bg-success" : percentage >= 50 ? "bg-warning" : "bg-danger";
                    
                    <div class="alert @alertClass">
                        <h5>✅ Робота оцінена</h5>
                        <p>
                            <strong>Оцінка:</strong> 
                            <span class="badge @badgeClass fs-5">@Model.Grade.Value / @Model.Assignment?.MaxGrade</span>
                            <span class="ms-2">(@string.Format("{0:F1}", percentage)%)</span>
                        </p>
                        <p><strong>Дата оцінювання:</strong> @Model.Grade.DateIssued.ToString("dd.MM.yyyy HH:mm")</p>
                        @if (!string.IsNullOrEmpty(Model.Grade.Comment))
                        {
                            <hr />
                            <p><strong>Коментар викладача:</strong></p>
                            <p class="mb-0" style="white-space: pre-wrap;">@Model.Grade.Comment</p>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        <h5>⏳ Робота очікує оцінювання</h5>
                        <p class="mb-0">Викладач ще не перевірив вашу роботу. Очікуйте оцінку.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
