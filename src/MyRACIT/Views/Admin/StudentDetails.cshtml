@model MyRACIT.Models.Entities.StudentProfile

@{
    ViewData["Title"] = $"Деталі студента - {Model.User?.Name}";
}

<div class="row">
    <div class="col-md-10 offset-md-1">
        <div class="card">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">👤 Інформація про студента</h4>
                <a asp-action="Students" class="btn btn-light btn-sm">⬅️ Назад</a>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h5>Особиста інформація</h5>
                        <table class="table table-borderless">
                            <tr>
                                <th>ПІБ:</th>
                                <td><strong>@Model.User?.Name</strong></td>
                            </tr>
                            <tr>
                                <th>Email:</th>
                                <td>@Model.User?.Email</td>
                            </tr>
                            <tr>
                                <th>Роль:</th>
                                <td><span class="badge bg-info">Студент</span></td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h5>Навчання</h5>
                        <table class="table table-borderless">
                            <tr>
                                <th>Група:</th>
                                <td><strong>@Model.Group?.Name</strong></td>
                            </tr>
                            <tr>
                                <th>Спеціальність:</th>
                                <td>@Model.Group?.Specialty?.Code - @Model.Group?.Specialty?.Name</td>
                            </tr>
                            <tr>
                                <th>Курс:</th>
                                <td>@Model.Group?.StudyYear курс</td>
                            </tr>
                        </table>
                    </div>
                </div>
                
                <hr />
                
                <div class="row mt-3">
                    <div class="col-12">
                        <h5>Статистика</h5>
                        <div class="row text-center">
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h3>@ViewBag.TotalSubmissions</h3>
                                        <p class="text-muted mb-0">Здано робіт</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h3>@ViewBag.TotalGrades</h3>
                                        <p class="text-muted mb-0">Отримано оцінок</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h3>@(ViewBag.AverageGrade ?? "N/A")</h3>
                                        <p class="text-muted mb-0">Середній бал</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
