@model IEnumerable<MyRACIT.Models.Entities.Course>

@{
    ViewData["Title"] = "Мої курси";

    var getCourseAssignments = ViewBag.GetCourseAssignments as Func<int, int> ?? (_ => 0);
    var getCourseSubmissions = ViewBag.GetCourseSubmissions as Func<int, int> ?? (_ => 0);
    var getStudentsCount = ViewBag.GetStudentsCount as Func<int, int> ?? (_ => 0);
}

<div class="row mb-3">
    <div class="col">
        <h2>Мої курси</h2>
        <p class="text-muted">Курси, які ви викладаєте</p>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        <strong>Інформація:</strong> У вас поки немає призначених курсів.
    </div>
}
else
{
    <div class="row">
        @foreach (var course in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100 border-primary">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">@course.Subject?.Title</h5>
                    </div>
                    <div class="card-body">
                        <p><strong>Група:</strong> <span class="badge bg-info">@course.Group?.Name</span></p>
                        <p><strong>Спеціальність:</strong> @course.Group?.Specialty?.Code - @course.Group?.Specialty?.Name</p>
                        <p><strong>Період:</strong> @course.StartDate.ToString("dd.MM.yyyy") - @course.EndDate.ToString("dd.MM.yyyy")</p>
                        
                        <hr />
                        
                        <div class="row text-center">
                            <div class="col-4">
                                <h4>@getCourseAssignments(course.Id)</h4>
                                <small class="text-muted">Завдань</small>
                            </div>
                            <div class="col-4">
                                <h4>@getCourseSubmissions(course.Id)</h4>
                                <small class="text-muted">Здач</small>
                            </div>
                            <div class="col-4">
                                <h4>@getStudentsCount(course.GroupId)</h4>
                                <small class="text-muted">Студентів</small>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-light">
                        <a asp-action="CourseDetails" asp-route-id="@course.Id" class="btn btn-sm btn-primary">
                            Деталі курсу
                        </a>
                        <a asp-action="Assignments" asp-route-courseId="@course.Id" class="btn btn-sm btn-success">
                            Завдання
                        </a>
                        <a asp-action="Submissions" asp-route-courseId="@course.Id" class="btn btn-sm btn-info">
                            Здачі
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
