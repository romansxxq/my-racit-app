@model IEnumerable<MyRACIT.Models.Entities.StudentProfile>

@{
    ViewData["Title"] = "Управління студентами";
}

<div class="row mb-3">
    <div class="col">
        <h2>🎓 Управління студентами</h2>
    </div>
    <div class="col text-end">
        <a asp-action="CreateStudent" class="btn btn-success">
            ➕ Додати студента
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <strong>ℹ️ Інформація:</strong> Студенти відсутні. Додайте першого студента.
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>№</th>
                        <th>ПІБ</th>
                        <th>Email</th>
                        <th>Група</th>
                        <th style="width: 150px;">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var index = 1;
                    }
                    @foreach (var student in Model)
                    {
                        <tr>
                            <td>@index</td>
                            <td><strong>@student.User?.Name</strong></td>
                            <td>@student.User?.Email</td>
                            <td><span class="badge bg-info">@student.Group?.Name</span></td>
                            <td>
                                <a asp-action="StudentDetails" asp-route-id="@student.Id" 
                                   class="btn btn-sm btn-info" title="Деталі">
                                    👁️
                                </a>
                                <button type="button" class="btn btn-sm btn-danger" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#deleteModal@(student.Id)"
                                        title="Видалити">
                                    🗑️
                                </button>
                            </td>
                        </tr>
                        
                        <div class="modal fade" id="deleteModal@(student.Id)" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header bg-danger text-white">
                                        <h5 class="modal-title">Підтвердження видалення</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>Ви впевнені, що хочете видалити студента <strong>"@student.User?.Name"</strong>?</p>
                                        <p class="text-danger"><small>⚠️ Увага: Ця дія незворотня!</small></p>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                                        <form asp-action="DeleteStudent" asp-route-id="@student.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-danger">Так, видалити</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        index++;
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="mt-3">
        <p class="text-muted">
            <small>Всього студентів: <strong>@Model.Count()</strong></small>
        </p>
    </div>
}
