@model IEnumerable<MyRACIT.Models.Entities.Course>

@{
    ViewData["Title"] = "Мої курси";
}

<div class="row mb-3">
    <div class="col">
        <h2>📚 Мої курси</h2>
        <p class="text-muted">Курси, на які ви записані</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <strong>ℹ️ Інформація:</strong> Ви не записані на жоден курс.
    </div>
}
else
{
    <div class="row">
        @foreach (var course in Model)
        {
            var progress = ViewBag.GetCourseProgress(course.Id);
            var progressPercentage = ViewBag.GetProgressPercentage(course.Id);
            
            <div class="col-md-6 mb-4">
                <div class="card h-100 border-success">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">@course.Subject?.Title</h5>
                    </div>
                    <div class="card-body">
                        <p><strong>Викладач:</strong> @course.Teacher?.User?.Name</p>
                        <p><strong>Група:</strong> <span class="badge bg-info">@course.Group?.Name</span></p>
                        <p><strong>Період:</strong> @course.StartDate.ToString("dd.MM.yyyy") - @course.EndDate.ToString("dd.MM.yyyy")</p>
                        
                        <hr />
                        
                        <div class="row text-center mb-3">
                            <div class="col-4">
                                <h4>@ViewBag.GetAssignmentsCount(course.Id)</h4>
                                <small class="text-muted">Завдань</small>
                            </div>
                            <div class="col-4">
                                <h4>@ViewBag.GetMySubmissions(course.Id)</h4>
                                <small class="text-muted">Здано</small>
                            </div>
                            <div class="col-4">
                                <h4>@ViewBag.GetMyGrades(course.Id)</h4>
                                <small class="text-muted">Оцінок</small>
                            </div>
                        </div>
                        
                        <div class="mb-2">
                            <small class="text-muted">Прогрес:</small>
                            <div class="progress">
                                <div class="progress-bar bg-success" role="progressbar" 
                                     style="width: @progressPercentage%" 
                                     aria-valuenow="@progressPercentage" aria-valuemin="0" aria-valuemax="100">
                                    @progressPercentage%
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-light">
                        <a asp-action="CourseDetails" asp-route-id="@course.Id" class="btn btn-sm btn-primary">
                            📖 Деталі
                        </a>
                        <a asp-action="Assignments" asp-route-courseId="@course.Id" class="btn btn-sm btn-success">
                            📝 Завдання
                        </a>
                        <a asp-action="MySubmissions" asp-route-courseId="@course.Id" class="btn btn-sm btn-info">
                            📬 Мої здачі
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
