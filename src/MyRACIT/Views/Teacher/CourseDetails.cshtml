@model MyRACIT.Models.Entities.Course

@{
    ViewData["Title"] = "Деталі курсу";
}

<div class="row">
    <div class="col-md-10 offset-md-1">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Мої курси</a></li>
                <li class="breadcrumb-item active">Деталі курсу</li>
            </ol>
        </nav>
        
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">📖 @Model.Subject?.Title</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h5>Інформація про курс</h5>
                        <table class="table table-borderless">
                            <tr>
                                <th>Предмет:</th>
                                <td><strong>@Model.Subject?.Title</strong></td>
                            </tr>
                            <tr>
                                <th>Група:</th>
                                <td><span class="badge bg-info">@Model.Group?.Name</span></td>
                            </tr>
                            <tr>
                                <th>Спеціальність:</th>
                                <td>@Model.Group?.Specialty?.Code - @Model.Group?.Specialty?.Name</td>
                            </tr>
                            <tr>
                                <th>Курс:</th>
                                <td>@Model.Group?.StudyYear рік</td>
                            </tr>
                            <tr>
                                <th>Період:</th>
                                <td>
                                    @Model.StartDate.ToString("dd.MM.yyyy") - @Model.EndDate.ToString("dd.MM.yyyy")
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h5>Статистика</h5>
                        <div class="row text-center">
                            <div class="col-6 mb-3">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h3>@ViewBag.StudentsCount</h3>
                                        <small class="text-muted">Студентів</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 mb-3">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h3>@ViewBag.AssignmentsCount</h3>
                                        <small class="text-muted">Завдань</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 mb-3">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h3>@ViewBag.SubmissionsCount</h3>
                                        <small class="text-muted">Здач</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 mb-3">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h3>@ViewBag.GradesCount</h3>
                                        <small class="text-muted">Оцінок</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <hr />
                
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">⬅️ До курсів</a>
                    <div>
                        <a asp-action="Assignments" asp-route-courseId="@Model.Id" class="btn btn-success">
                            📝 Завдання
                        </a>
                        <a asp-action="Submissions" asp-route-courseId="@Model.Id" class="btn btn-info">
                            📬 Здачі
                        </a>
                        <a asp-action="Grades" asp-route-courseId="@Model.Id" class="btn btn-warning">
                            ⭐ Оцінки
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
