@model IEnumerable<MyRACIT.Models.Entities.Specialty>

@{
    ViewData["Title"] = "Управління спеціальностями";
}

<div class="row mb-3">
    <div class="col">
        <h2>🎯 Управління спеціальностями</h2>
    </div>
    <div class="col text-end">
        <a asp-action="CreateSpecialty" class="btn btn-success">
            ➕ Додати спеціальність
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <strong>ℹ️ Інформація:</strong> Спеціальності відсутні. Додайте першу спеціальність.
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>№</th>
                        <th>Код</th>
                        <th>Назва спеціальності</th>
                        <th style="width: 150px;">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var index = 1;
                    }
                    @foreach (var specialty in Model)
                    {
                        <tr>
                            <td>@index</td>
                            <td><span class="badge bg-primary">@specialty.Code</span></td>
                            <td><strong>@specialty.Name</strong></td>
                            <td>
                                <a asp-action="EditSpecialty" asp-route-id="@specialty.Id" 
                                   class="btn btn-sm btn-primary" title="Редагувати">
                                    ✏️
                                </a>
                                <button type="button" class="btn btn-sm btn-danger" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#deleteModal@(specialty.Id)"
                                        title="Видалити">
                                    🗑️
                                </button>
                            </td>
                        </tr>
                        
                        <div class="modal fade" id="deleteModal@(specialty.Id)" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header bg-danger text-white">
                                        <h5 class="modal-title">Підтвердження видалення</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>Ви впевнені, що хочете видалити спеціальність <strong>"@specialty.Code - @specialty.Name"</strong>?</p>
                                        <p class="text-danger"><small>⚠️ Увага: Ця дія незворотня!</small></p>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                                        <form asp-action="DeleteSpecialty" asp-route-id="@specialty.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-danger">Так, видалити</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        index++;
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="mt-3">
        <p class="text-muted">
            <small>Всього спеціальностей: <strong>@Model.Count()</strong></small>
        </p>
    </div>
}
