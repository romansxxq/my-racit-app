@{
    ViewData["Title"] = "Створити студента";
}

<h1>➕ Створити студента</h1>
<p class="text-muted">Використовується <strong>Factory Method Pattern</strong> для створення користувача</p>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="CreateStudent" method="post">
            <div class="mb-3">
                <label for="name" class="form-label">ПІБ студента</label>
                <input type="text" class="form-control" id="name" name="name" required 
                       placeholder="Іванов Іван Іванович" />
            </div>
            
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" name="email" required 
                       placeholder="ivanov@student.rfkit.edu.ua" />
                <div class="form-text">Пароль буде автоматично згенеровано та відправлено на email</div>
            </div>
            
            <div class="mb-3">
                <label for="groupId" class="form-label">Група</label>
                <select class="form-select" id="groupId" name="groupId" required>
                    <option value="">-- Оберіть групу --</option>
                    @foreach (var group in ViewBag.Groups as List<MyRACIT.Models.Entities.Group>)
                    {
                        <option value="@group.Id">@group.Name (Курс @group.StudyYear)</option>
                    }
                </select>
            </div>
            
            <div class="mb-3">
                <button type="submit" class="btn btn-success">✅ Створити студента</button>
                <a asp-action="Users" class="btn btn-secondary">↩️ Назад</a>
            </div>
        </form>
    </div>
    
    <div class="col-md-6">
        <div class="alert alert-info">
            <h5>🏭 Factory Method Pattern</h5>
            <p>Фабрика <code>UserFactory.CreateStudent()</code> автоматично:</p>
            <ul>
                <li>Генерує безпечний випадковий пароль (12 символів)</li>
                <li>Хешує пароль за допомогою SHA256</li>
                <li>Призначає роль <code>UserRole.Student</code></li>
                <li>Логує створення користувача</li>
            </ul>
            <p class="mb-0">
                <strong>Переваги:</strong> Весь код створення в одному місці, легко змінити логіку для всіх місць використання.
            </p>
        </div>
        
        <div class="alert alert-warning">
            <h5>⚠️ TODO</h5>
            <p class="mb-0">В майбутньому додати відправку email з паролем через SMTP сервіс.</p>
        </div>
    </div>
</div>
