@model MyRACIT.Models.Entities.StudentProfile

@{
    ViewData["Title"] = "Мій профіль";
}

<div class="row mb-4">
    <div class="col">
        <h2> Профіль студента</h2>
        <p class="text-muted">Перегляд вашого профілю та статистики</p>
    </div>
</div>

<!-- Інформація про студента -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card border-primary">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Особиста інформація</h5>
            </div>
            <div class="card-body">
                <p><strong>Ім'я:</strong> @Model.User?.Name</p>
                <p><strong>Email:</strong> @Model.User?.Email</p>
                <p><strong>Група:</strong> <span class="badge bg-info">@Model.Group?.Name</span></p>
                <p><strong>Спеціальність:</strong> @Model.Group?.Specialty?.Name</p>
            </div>
        </div>
    </div>

    <!-- Статистика -->
    <div class="col-md-8">
        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="card border-success">
                    <div class="card-body text-center">
                        <h3 class="text-success">@ViewBag.TotalCourses</h3>
                        <p class="mb-0"> Курсів</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="card border-info">
                    <div class="card-body text-center">
                        <h3 class="text-info">@ViewBag.TotalSubmissions</h3>
                        <p class="mb-0"> Здач</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="card border-warning">
                    <div class="card-body text-center">
                        <h3 class="text-warning">@ViewBag.TotalGrades</h3>
                        <p class="mb-0"> Оцінок</p>
                    </div>
                </div>
            </div>
            <div class="col-md-12 mb-3">
                <div class="card border-primary">
                    <div class="card-body text-center">
                        <h3 class="text-primary">@ViewBag.AverageGrade</h3>
                        <p class="mb-0"> Середній бал</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Швидкі посилання -->
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0"> Швидкі посилання</h5>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-6">
                        <a asp-action="MyCourses" class="btn btn-lg btn-outline-success w-100">
                            Мої курси
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a asp-action="MyGrades" class="btn btn-lg btn-outline-warning w-100">
                            Мої оцінки
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
