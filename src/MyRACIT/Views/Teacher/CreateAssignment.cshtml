@model MyRACIT.Models.Entities.Assignment

@{
    ViewData["Title"] = "Створити завдання";
    var courseId = ViewBag.CourseId as int?;
    var courseName = ViewBag.CourseName as string;
}

<link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet" />
<style>
    #description-editor { height: 220px; background: #fff; }
    .ql-toolbar.ql-snow { border-radius: 4px 4px 0 0; }
    .ql-container.ql-snow { border-radius: 0 0 4px 4px; font-size: 1rem; }
    .file-drop-zone {
        border: 2px dashed #adb5bd;
        border-radius: 8px;
        padding: 1.5rem;
        text-align: center;
        cursor: pointer;
        transition: border-color .2s;
    }
    .file-drop-zone:hover, .file-drop-zone.drag-over { border-color: #0d6efd; background: #f0f4ff; }
    .file-list-item { display: flex; align-items: center; gap: .5rem; padding: .35rem .5rem;
                      background: #f8f9fa; border-radius: 4px; margin-top: .4rem; font-size: .875rem; }
    .file-list-item .remove-file { cursor: pointer; color: #dc3545; margin-left: auto; }
</style>

<div class="row">
    <div class="col-md-10 offset-md-1">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Мої курси</a></li>
                <li class="breadcrumb-item"><a asp-action="Assignments" asp-route-courseId="@courseId">@courseName</a></li>
                <li class="breadcrumb-item active">Нове завдання</li>
            </ol>
        </nav>

        <div class="card">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">➕ Створення нового завдання</h4>
            </div>
            <div class="card-body">
                <form asp-action="CreateAssignment" method="post" enctype="multipart/form-data" id="createForm">
                    <input type="hidden" name="CourseId" value="@courseId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Назва завдання <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" placeholder="Наприклад: Лабораторна робота №1" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Опис завдання</label>
                        <div id="description-editor">@Html.Raw(Model.Description)</div>
                        <input type="hidden" asp-for="Description" id="Description" />
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Deadline" class="form-label">Дедлайн <span class="text-danger">*</span></label>
                            <input asp-for="Deadline" type="datetime-local" class="form-control" />
                            <span asp-validation-for="Deadline" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="MaxGrade" class="form-label">Максимальний бал <span class="text-danger">*</span></label>
                            <input asp-for="MaxGrade" type="number" class="form-control" min="1" max="100" value="100" />
                            <span asp-validation-for="MaxGrade" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Файли до завдання <small class="text-muted">(PDF, DOCX, PPTX — до 10 MB кожен)</small></label>
                        <div class="file-drop-zone" id="dropZone" onclick="document.getElementById('fileInput').click()">
                            <div class="text-muted mb-1">📎 Перетягніть файли сюди або натисніть для вибору</div>
                            <small class="text-muted">Дозволені формати: .pdf, .docx, .pptx</small>
                        </div>
                        <input type="file" name="files" id="fileInput" multiple
                               accept=".pdf,.docx,.pptx" class="d-none" />
                        <div id="fileList" class="mt-2"></div>
                        <span class="text-danger small" id="fileError"></span>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                        <a asp-action="Assignments" asp-route-courseId="@courseId" class="btn btn-secondary">
                            ⬅️ Скасувати
                        </a>
                        <button type="submit" class="btn btn-success">
                            💾 Створити завдання
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
    <script>
        // ── Quill rich-text editor ──────────────────────────────────────────
        const quill = new Quill('#description-editor', {
            theme: 'snow',
            placeholder: 'Детально опишіть що потрібно зробити...',
            modules: {
                toolbar: [
                    [{ header: [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    [{ list: 'ordered' }, { list: 'bullet' }],
                    [{ indent: '-1' }, { indent: '+1' }],
                    ['blockquote', 'code-block'],
                    ['link'],
                    ['clean']
                ]
            }
        });

        // Sync Quill HTML → hidden input before submit
        document.getElementById('createForm').addEventListener('submit', function () {
            document.getElementById('Description').value = quill.root.innerHTML;
        });

        // ── File upload with drag-and-drop ──────────────────────────────────
        const allowed = ['.pdf', '.docx', '.pptx'];
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const fileList = document.getElementById('fileList');
        const fileError = document.getElementById('fileError');

        // Keep a DataTransfer to accumulate files across selections
        let dt = new DataTransfer();

        function extOf(name) { return name.substring(name.lastIndexOf('.')).toLowerCase(); }

        function addFiles(newFiles) {
            fileError.textContent = '';
            for (const f of newFiles) {
                if (!allowed.includes(extOf(f.name))) {
                    fileError.textContent = `Недозволений тип: ${f.name}. Дозволено: PDF, DOCX, PPTX.`;
                    continue;
                }
                // Skip duplicates by name
                if ([...dt.files].some(x => x.name === f.name)) continue;
                dt.items.add(f);
            }
            fileInput.files = dt.files;
            renderList();
        }

        function renderList() {
            fileList.innerHTML = '';
            [...dt.files].forEach((f, i) => {
                const div = document.createElement('div');
                div.className = 'file-list-item';
                div.innerHTML = `<span>📄 ${f.name}</span><small class="text-muted">(${(f.size/1024).toFixed(0)} KB)</small>
                    <span class="remove-file" data-i="${i}" title="Видалити">✕</span>`;
                fileList.appendChild(div);
            });
        }

        fileList.addEventListener('click', function (e) {
            const btn = e.target.closest('.remove-file');
            if (!btn) return;
            const idx = parseInt(btn.dataset.i);
            const newDt = new DataTransfer();
            [...dt.files].forEach((f, i) => { if (i !== idx) newDt.items.add(f); });
            dt = newDt;
            fileInput.files = dt.files;
            renderList();
        });

        fileInput.addEventListener('change', () => addFiles(fileInput.files));

        dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('drag-over'); });
        dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
        dropZone.addEventListener('drop', e => {
            e.preventDefault();
            dropZone.classList.remove('drag-over');
            addFiles(e.dataTransfer.files);
        });
    </script>
}
